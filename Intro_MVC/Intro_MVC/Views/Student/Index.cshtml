
@{
    ViewBag.Title = "Index";
}

<a class="btn btn-danger" href="/student/index">Index</a>
<a class="btn btn-success" href="/student/create">Create</a>

<h2>Index</h2>

<table class="table table-bordered">
    <tr>
        <th>Name</th>
        <th>Id</th>
        <th>Cgpa</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Id</td>
            <td>@item.Cgpa</td>
        </tr>
    }
</table>
