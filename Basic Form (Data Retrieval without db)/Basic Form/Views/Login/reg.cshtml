
@{
    ViewBag.Title = "reg";
}

<h2>Registration Form</h2><br />

<form action="" method="post">
    <input type="text" name="Name" placeholder="Name" class="form-control" /> <br />
    <input type="email" name="Password" placeholder="Email" class="form-control" /><br />
    <input type="number" name="Number" placeholder="Number" class="form-control" /><br />
    <input type="password" name="" placeholder="Password" class="form-control" /><br />
    <button type="submit" name="Submit" class="btn btn-primary">Register</button>
    <button type="reset" name="Reset" class="btn btn-danger">Reset</button>
    <a href="/Login/log" class="btn btn-secondary">Login</a>
</form>