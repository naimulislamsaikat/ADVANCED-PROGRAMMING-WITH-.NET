
@{
    ViewBag.Title = "Index";
}

<h2>Login</h2>

<h4>@ViewBag.Uname</h4>
<h4>@ViewBag.Pass</h4>

@Html.ValidationSummary()

<form action="" method="post">
    <input type="text" placeholder="Username" class="form-control" value="@ViewBag.Username" name="Username" />
    <span class="text-danger">@Html.ValidationMessage("Username")</span>

    <input type="password" placeholder="Password" class="form-control" value="@ViewBag.Password" name="Password" />
    <span class="text-danger">@Html.ValidationMessage("Password")</span><br />

    <input type="submit" value="Login" class="btn btn-success" />

    <a href="/Login/Register" class="btn btn-primary">Registration</a>
</form>
